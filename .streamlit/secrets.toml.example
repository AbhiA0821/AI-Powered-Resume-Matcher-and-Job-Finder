# ==============================================================================
# Streamlit Community Cloud Secrets Template
# PLACEHOLDERS ONLY - NEVER COMMIT REAL SECRETS OR SECRETS.TOML TO GIT
# On Streamlit Community Cloud: Paste these into App Settings -> Secrets
# ==============================================================================

# Application Environment
ENVIRONMENT = "production"
PROJECT_NAME = "HireAgent — AI-Powered Resume Matcher and Job Finder"

# Optional: Remote FastAPI Backend URL (leave empty or omit to use direct in-process engine)
# Example: "https://hireagent-backend.onrender.com"
BACKEND_URL = ""

# Database Configuration
# Default fallback is local SQLite catalog: "sqlite:///./data/resume_matcher.db"
# For persistent multi-user database in cloud deployment, configure Turso Cloud (libSQL):
TURSO_DATABASE_URL = "libsql://<your-database-name>-<org-name>.turso.io"
TURSO_AUTH_TOKEN = "your_turso_auth_token_here"
DATABASE_URL = ""

# JWT Secret Key for Session Authentication (minimum 32 characters)
JWT_SECRET_KEY = "CHANGE_ME_TO_A_CRYPTOGRAPHICALLY_SECURE_SECRET_AT_LEAST_32_CHARS"
JWT_ALGORITHM = "HS256"
JWT_ACCESS_TOKEN_EXPIRE_MINUTES = 1440

# Live Job Discovery API (RapidAPI / JSearch - 200 req/month hard cap)
RAPIDAPI_KEY = "your_rapidapi_jsearch_key_here"
RAPIDAPI_HOST = "jsearch.p.rapidapi.com"
RAPIDAPI_JOB_ENDPOINT = "https://jsearch.p.rapidapi.com/search"

# Primary LLM: Google Gemini API (for AI Career Assistant and Resume Insights)
GEMINI_API_KEY = "your_gemini_api_key_here"
GEMINI_MODEL = "gemini-2.5-flash"

# Fallback LLM: Groq API
GROQ_API_KEY = "your_groq_api_key_here"
GROQ_MODEL = "llama-3.3-70b-versatile"

# Optional: Qdrant Cloud Vector Database (for semantic vector indexing)
QDRANT_URL = "https://your-cluster-id.cloud.qdrant.io:6333"
QDRANT_API_KEY = "your_qdrant_api_key_here"
QDRANT_RESUMES_COLLECTION = "hireagent_resumes"
QDRANT_JOBS_COLLECTION = "hireagent_jobs"

# Centralized Embedding Model Settings (FastEmbed ONNX)
EMBEDDING_MODEL = "sentence-transformers/all-MiniLM-L6-v2"
EMBEDDING_DIMENSION = 384
FASTEMBED_CACHE_PATH = "./.fastembed_cache"

# Hugging Face Model Token (Optional, to avoid rate-limiting on model download)
HF_TOKEN = "your_huggingface_read_token_here"

# Telemetry Opt-out Flags
CREWAI_TELEMETRY_OPT_OUT = "true"
OTEL_SDK_DISABLED = "true"
