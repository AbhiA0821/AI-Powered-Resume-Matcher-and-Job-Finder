# ==============================================================================
# AI-Powered Resume Matcher and Job Finder Environment Variables Template
# PLACEHOLDERS ONLY - NEVER COMMIT REAL SECRETS
# ==============================================================================

# Application Environment
ENVIRONMENT=development
PROJECT_NAME="AI-Powered Resume Matcher and Job Finder API"
API_V1_STR="/api/v1"

# Database Configuration (MySQL / SQLite catalog fallback)
DATABASE_URL=mysql+pymysql://root:password@localhost:3306/hireagent

# Turso Cloud Database (libSQL) - Recommended for Production Deployment
TURSO_DATABASE_URL=libsql://<your-database-name>-<org-name>.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token-here

# JWT Authentication
JWT_SECRET_KEY=CHANGE_ME_TO_A_CRYPTOGRAPHICALLY_SECURE_SECRET_AT_LEAST_32_CHARS
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS & Frontend URLs Configuration
# In production, set FRONTEND_URL to your deployed frontend domain (e.g., https://hireagent-frontend.onrender.com)
FRONTEND_URL=
CORS_ORIGINS="http://localhost:5000,http://127.0.0.1:5000"

# Flask Frontend Configuration
FLASK_SECRET_KEY=CHANGE_ME_TO_A_SECURE_RANDOM_KEY
# In local development: http://127.0.0.1:8000
# In Render production: https://hireagent-backend.onrender.com (or internal service host)
BACKEND_URL=http://127.0.0.1:8000
HIREAGENT_API_URL=http://127.0.0.1:8000

# Primary LLM: Google Gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Fallback LLM: Groq
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Qdrant Cloud Vector Database
QDRANT_URL=https://your-cluster-id.cloud.qdrant.io:6333
QDRANT_API_KEY=your_qdrant_api_key_here

# RapidAPI / JSearch (Strict 200 req/month hard cap)
RAPIDAPI_KEY=your_rapidapi_key_here
RAPIDAPI_HOST=jsearch.p.rapidapi.com
RAPIDAPI_JOB_ENDPOINT=https://jsearch.p.rapidapi.com/search

# Centralized Embedding Model (FastEmbed ONNX Runtime)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384
FASTEMBED_CACHE_PATH=./.fastembed_cache
QDRANT_RESUMES_COLLECTION=hireagent_resumes
QDRANT_JOBS_COLLECTION=hireagent_jobs

# Hugging Face Model Hub (Optional read token to avoid unauthenticated rate limit notices)
HF_TOKEN=your_huggingface_read_token_here

# CrewAI Multi-Agent Flags (No telemetry, no OpenAI key required)
CREWAI_TELEMETRY_OPT_OUT=true
OTEL_SDK_DISABLED=true

# AI Career Assistant Rate Limiting
ASSISTANT_RATE_LIMIT_PER_MINUTE=15

# Firebase Admin Configuration (Backend Token Verification)
# Path to service account JSON (never expose to client)
FIREBASE_CREDENTIALS_PATH=secrets/firebase-service-account.json

# Firebase Web Client Configuration (Frontend Google Sign-In)
# Public keys from Firebase Console -> Project Settings -> General -> Your apps -> Web app
FIREBASE_API_KEY=your_firebase_web_api_key_here
FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
FIREBASE_APP_ID=1:your_app_id:web:your_web_id
